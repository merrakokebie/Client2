-- Credit lines with loan history but no credit line history row
SELECT DISTINCT l.CreditLineID
FROM LoanHistory lh
JOIN Loan l ON l.LoanID = lh.LoanID
LEFT JOIN CreditLineHistory clh
       ON clh.CreditLineID = l.CreditLineID AND clh.PeriodEndDate = @PED
WHERE lh.PeriodEndDate = @PED AND clh.CreditLineID IS NULL;
